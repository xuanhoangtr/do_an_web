# Copy to .env for local Compose use. Never commit the populated file.
# This example selects the isolated local profile; production must use its
# secret manager values and the default/production profile instead.
SPRING_PROFILES_ACTIVE=local
POSTGRES_DB=webthiep
DB_USER=webthiep
DB_PASSWORD=replace-with-a-local-password

# Generate a persistent local key once with:
#   .\scripts\Initialize-LocalFieldEncryptionKey.ps1
# Keep generated key material in the gitignored .local-secrets directory.
# Production/default startup requires real key-ring values from a secret manager.
APP_ENVIRONMENT=development
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
FIELD_ENCRYPTION_KEYS=

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
CORS_ALLOWED_ORIGINS=http://localhost:8000
# Optional. If omitted, WebSocket origins inherit CORS_ALLOWED_ORIGINS.
# WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8000

# The local profile uses an ephemeral RS256 key when these are blank. The key
# disappears on restart and must never be enabled in production. In production,
# supply keys from a secret manager. Public ring format: kid=base64-X509[,kid=key].
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_ACTIVE_KID=primary
JWT_ISSUER=utewedding
JWT_AUDIENCE=utewedding-api
AUDIT_IP_SALT=utewedding-local-audit-ip-salt-not-for-production
# Required for the __Host-wt_rt refresh cookie. Use HTTPS.
COOKIE_SECURE=true

MAIL_DRIVER=noop
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@example.invalid

# Optional operations stack. See deploy/observability/README.md and deploy/backup/README.md.
# Do not put production passphrases in this example. Supply them only in the untracked .env
# or in a secret file mounted by Compose.
# GRAFANA_ADMIN_PASSWORD=
# ALERT_WEBHOOK_URL=https://alerts.example.invalid/hooks/utewedding
# BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_OFFSITE_HOST_PATH=
# BACKUP_OFFSITE_IS_REMOTE=false
# BACKUP_REQUIRE_OFFSITE=true
# POSTGRES_EXPORTER_DATA_SOURCE_NAME=
SHIPPING_DEFAULT_PROVIDER=INTERNAL
SHIPPING_PROVIDER_WEBHOOK_SECRET=
RISK_HMAC_SECRET=replace-with-at-least-32-random-bytes
FINANCE_MEDIA_RETENTION_DAYS=2555
